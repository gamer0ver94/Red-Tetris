{
  "name": "red-tetris-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:client": "tsc -p src/client/tsconfig.json && cp src/client/index.html src/client/dist/index.html",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc --noEmit",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",

    "docs:asyncapi:validate": "asyncapi validate docs/asyncapi.yaml",
    "docs:asyncapi:build": "asyncapi generate fromTemplate docs/asyncapi.yaml @asyncapi/html-template -o docs/asyncapi-site --force-write",
    "docs:asyncapi:preview": "asyncapi start preview docs/asyncapi.yaml -B"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/secure-session": "^8.2.0",
    "@fastify/cookie": "^11.0.2",
    "socket.io": "^4.8.3",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@asyncapi/cli": "^6.0.0",
    "@asyncapi/parser": "^3.6.0",
    "@asyncapi/html-template": "^3.5.6"
  }
}
